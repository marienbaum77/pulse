# ============ обязательное ============
POSTGRES_PASSWORD=
SECRET_KEY=            # openssl rand -hex 32  (не короче 32 символов)
ADMIN_EMAIL=admin@example.com
# Пароль первого администратора. Используется ТОЛЬКО при самом первом запуске, когда в базе ещё нет пользователей.
# Изменение этой строки позже пароль не меняет; сменить его: docker compose exec api python -m app.admin reset-password
ADMIN_PASSWORD=

# ============ доступ ============
PULSE_PORT=8080
COOKIE_SECURE=false    # true, когда интерфейс открыт по HTTPS (на VPS с доменом — всегда true)
PULSE_DOMAIN=          # только для docker-compose.prod.yml: pulse.example.com

# ============ модели ============
# openai — любой OpenAI-совместимый сервер (по умолчанию Groq; также Ollama, vLLM и другие).
# stub — без чат-модели; посты будут собираться экстрактивно.
# Какие модели нужны и зачем — в docs/configuration.md, раздел «Модели».
# Модели можно потом сменить в интерфейсе: Система → Состояние → Модели (без перезапуска).
LLM_PROVIDER=openai
LLM_CHAT_ENABLED=true
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=                            # задайте новый ключ провайдера локально; не коммитьте .env
LLM_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT=180                         # лимит ожидания ответа модели в секундах
EMBED_MODEL=bge-m3                      # локальная модель эмбеддингов для сюжетов и близости к теме
# Эмбеддинги можно направить на отдельный сервер; по умолчанию используется Ollama из стека.
EMBED_BASE_URL=http://ollama:11434/v1
EMBED_API_KEY=
# Ollama: ограничиваем контекст, число одновременно загруженных моделей и параллельных запросов на ПК с небольшой памятью.
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_KEEP_ALIVE=1m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
# 3 = 1 воркер для generate + 2 общих; при удалённом chat API это не нагружает локальную память.
# При локальном Ollama для генерации можно снизить до 1.
WORKER_CONCURRENCY=3

# ============ публикация ============
TELEGRAM_BOT_TOKEN=    # токен от @BotFather; бот должен быть администратором канала
# VK_ACCESS_TOKEN=     # необязательно: токен сообщества; можно вместо этого ввести токен в UI канала

# ============ бот TikTok (docker-compose.tiktok.yml, см. tiktok-bot/README.md) ============
# TIKTOK_BOT_TELEGRAM_TOKEN=   # ОТДЕЛЬНЫЙ бот от @BotFather; ролики — только из постов, пересланных ему в личку
# TIKTOK_BOT_OWNER_ID=         # ваш числовой id в Telegram: бот подскажет его в ответ на любое сообщение
# TIKTOK_BOT_CHANNEL=@my_channel   # необязательно: подпись для постов из приватного канала
# TIKTOK_CLIENT_KEY=           # TikTok for Developers → приложение → Client key
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://example.com/tiktok/callback   # тот же адрес, что в настройках Login Kit
# TIKTOK_BOT_HASHTAGS=#ии #нейросети #технологии
# TIKTOK_BOT_SCREENSHOT=1          # ролик — скриншот поста с его видео; 0 — прежние слайды
# TIKTOK_BOT_TIMEZONE=Europe/Moscow   # время поста на скриншоте
# TIKTOK_BOT_MAX_VIDEO_SECONDS=600    # видео поста идёт целиком, но не дольше (TikTok через API — до 10 минут)

# ============ дедуп (MinHash Stage 1) ============
MINHASH_DEDUP_ENABLED=true
MINHASH_THRESHOLD=0.82     # Jaccard; выше — строже (меньше ложных дублей, больше пропусков перепечаток)

# ============ поиск контента ============
# Встроенный SearXNG для источников «Веб-поиск» и поиска видео YouTube; пусто — веб-поиск отключён.
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=            # пусто — используется SECRET_KEY
YOUTUBE_PROXY_URL=         # http://user:pass@proxy:port — только для субтитров YouTube, если VPS заблокирован

# ============ прочее ============
ALLOW_PRIVATE_URLS=false   # true разрешает источникам и webhook-адресам указывать на внутренние сети
RETENTION_DAYS=30
BACKUP_KEEP_DAYS=14        # сколько дней хранить дампы из контейнера backup (./backups)
BACKUP_KEEP_COUNT=7        # максимум файлов бэкапа независимо от срока
IMAGE_CACHE_MAX_MB=500
IMAGE_CACHE_MAX_AGE_DAYS=30
