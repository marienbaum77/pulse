# ============ обязательное ============
POSTGRES_PASSWORD=
SECRET_KEY=            # openssl rand -hex 32  (не короче 32 символов)
ADMIN_EMAIL=admin@example.com
# Пароль первого администратора. Используется ТОЛЬКО при самом первом запуске, когда в базе ещё нет пользователей.
# Изменение этой строки позже пароль не меняет; сменить его: docker compose exec api python -m app.admin reset-password
ADMIN_PASSWORD=

# ============ доступ ============
PULSE_PORT=8080
COOKIE_SECURE=false    # true, когда интерфейс открыт по HTTPS (на VPS с доменом — всегда true)
PULSE_DOMAIN=          # только для docker-compose.prod.yml: pulse.example.com

# ============ модели ============
# stub — без языковой модели (экстрактивный режим). openai — любой сервер с OpenAI-совместимым API (Ollama, vLLM, облако).
# Какие модели нужны и зачем — в README, раздел «Модели».
# Модели можно потом сменить в интерфейсе: Система → Состояние → Модели (без перезапуска).
LLM_PROVIDER=stub
LLM_BASE_URL=http://ollama:11434/v1     # сервер с текстовой моделью; на Windows с нативным Ollama: http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct           # пишет текст постов; нужна только в режимах «Авто» / «Языковая модель»
LLM_TIMEOUT=180                         # лимит ожидания ответа модели в секундах; увеличьте, если Ollama работает медленно
EMBED_MODEL=bge-m3                      # превращает тексты в векторы: сюжеты и близость к теме; нужна всегда, кроме stub
# Эмбеддинги с другого сервера, чем текст (пусто = тот же, что LLM_BASE_URL):
EMBED_BASE_URL=
EMBED_API_KEY=

# ============ публикация ============
TELEGRAM_BOT_TOKEN=    # токен от @BotFather; бот должен быть администратором канала

# ============ прочее ============
ALLOW_PRIVATE_URLS=false   # true разрешает источникам и webhook-адресам указывать на внутренние сети
RETENTION_DAYS=30
WORKER_CONCURRENCY=2
BACKUP_KEEP_DAYS=14        # сколько дней хранить дампы из контейнера backup (./backups)
